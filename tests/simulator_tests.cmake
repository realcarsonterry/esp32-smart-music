if(NOT DEFINED SIMULATOR OR NOT DEFINED SOURCE_DIR OR NOT DEFINED TEST_DIR)
    message(FATAL_ERROR "Missing simulator test paths")
endif()
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef run_id)
set(TEST_DIR "${TEST_DIR}/${run_id}")
file(MAKE_DIRECTORY "${TEST_DIR}")
set(fixture "${SOURCE_DIR}/shared/fixtures/valid-one-bar.json")
set(wav "${TEST_DIR}/valid-one-bar.wav")
execute_process(COMMAND "${SIMULATOR}" "${fixture}" "${wav}"
    RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT code STREQUAL "0")
    message(FATAL_ERROR "Valid fixture exit=${code}: ${error}")
endif()
# Independently inspect the bytes written by the CLI, not its status message.
file(SIZE "${wav}" size)
file(READ "${wav}" header LIMIT 44 HEX)
set(expected "524946462471020057415645666d74201000000001000100007d000000fa0000020010006461746100710200")
if(NOT size EQUAL 160044 OR NOT header STREQUAL expected)
    message(FATAL_ERROR "WAV is not 80000 samples / PCM / 32000 Hz / mono / 16-bit: ${size}, ${header}")
endif()
file(READ "${wav}" first_second OFFSET 44 LIMIT 64000 HEX)
string(REPLACE "00" "" nonzero "${first_second}")
if(nonzero STREQUAL "")
    message(FATAL_ERROR "First second is all silent")
endif()
message(STATUS "Valid fixture: exit=0 samples=80000 rate=32000 channels=1 bits=16 first_second_nonzero=true")

function(expect_invalid name input)
    set(output_path "${TEST_DIR}/${name}.wav")
    if(EXISTS "${output_path}")
        message(FATAL_ERROR "Use a fresh TEST_DIR; output already exists: ${output_path}")
    endif()
    execute_process(COMMAND "${SIMULATOR}" "${input}" "${output_path}"
        RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT code STREQUAL "2" OR EXISTS "${output_path}")
        message(FATAL_ERROR "${name}: expected exit=2, no output; exit=${code}: ${error}")
    endif()
    # Invalid input must also leave an existing output untouched.
    set(sentinel "${TEST_DIR}/${name}-existing.wav")
    file(WRITE "${sentinel}" "preserve-existing-output")
    execute_process(COMMAND "${SIMULATOR}" "${input}" "${sentinel}"
        RESULT_VARIABLE existing_code OUTPUT_QUIET ERROR_QUIET)
    file(READ "${sentinel}" content)
    if(NOT existing_code STREQUAL "2" OR NOT content STREQUAL "preserve-existing-output")
        message(FATAL_ERROR "${name}: invalid JSON modified an existing output")
    endif()
    message(STATUS "${name}: exit=2 output_exists=false existing_output_preserved=true")
endfunction()

foreach(name IN ITEMS invalid-bpm invalid-midi invalid-overflow-time invalid-polyphony invalid-version)
    expect_invalid("${name}" "${SOURCE_DIR}/shared/fixtures/${name}.json")
endforeach()

file(READ "${fixture}" valid)
function(reject_replacement name before after)
    string(REPLACE "${before}" "${after}" changed "${valid}")
    if(changed STREQUAL valid)
        message(FATAL_ERROR "Test mutation did not change input: ${name}")
    endif()
    set(path "${TEST_DIR}/${name}.json")
    file(WRITE "${path}" "${changed}")
    expect_invalid("${name}" "${path}")
endfunction()

reject_replacement(fractional-bpm "\"bpm\": 96" "\"bpm\": 96.5")
reject_replacement(string-bpm "\"bpm\": 96" "\"bpm\": \"96\"")
reject_replacement(leading-zero "\"bpm\": 96" "\"bpm\": 096")
reject_replacement(trailing-dot "\"bpm\": 96" "\"bpm\": 96.")
reject_replacement(negative-seed "\"seed\": 1" "\"seed\": -1")
reject_replacement(overflow-seed "\"seed\": 1" "\"seed\": 4294967296")
reject_replacement(overflow-tick "\"duration_tick\": 480" "\"duration_tick\": 4294967296")
reject_replacement(wrap-span "\"duration_tick\": 480" "\"duration_tick\": 4294967295")
reject_replacement(duplicate-key "\"seed\": 1" "\"seed\": 1, \"seed\": 2")
reject_replacement(extra-key "\"seed\": 1" "\"seed\": 1, \"extra\": 2")
reject_replacement(missing-key "\"seed\": 1," "")
reject_replacement(nested-extra "\"numerator\": 4" "\"extra\": 1, \"numerator\": 4")
reject_replacement(unknown-part "\"part\": \"melody\"" "\"part\": \"bass\"")
reject_replacement(duplicate-id "\"id\": \"m0\"" "\"id\": \"a0\"")
reject_replacement(wrong-chord-pitch "\"midi\": 48" "\"midi\": 49")
reject_replacement(overlong-id "\"id\": \"m0\"" "\"id\": \"0123456789abcdef\"")
reject_replacement(embedded-nul "fixture-one-bar" "fixture\\u0000hidden")
reject_replacement(request-id-space "fixture-one-bar" "fixture id")
reject_replacement(request-id-unicode "fixture-one-bar" "任")
reject_replacement(request-id-newline "fixture-one-bar" "fixture\\n")
reject_replacement(request-id-empty "fixture-one-bar" "")
string(REPEAT "x" 65 overlong_request_id)
reject_replacement(request-id-overlong "fixture-one-bar" "${overlong_request_id}")
foreach(name IN ITEMS empty truncated trailing-json)
    set(path "${TEST_DIR}/${name}.json")
    if(name STREQUAL "empty")
        file(WRITE "${path}" "")
    elseif(name STREQUAL "truncated")
        file(WRITE "${path}" "{\"ok\":")
    else()
        file(WRITE "${path}" "${valid} {}")
    endif()
    expect_invalid("${name}" "${path}")
endforeach()

# Exercise uint32 seed endpoints without cJSON's saturating valueint field,
# and assert repeatability at the CLI boundary.
foreach(seed IN ITEMS 0 4294967295)
    string(REPLACE "\"seed\": 1" "\"seed\": ${seed}" changed "${valid}")
    set(path "${TEST_DIR}/seed-${seed}.json")
    file(WRITE "${path}" "${changed}")
    foreach(pass IN ITEMS 1 2)
        execute_process(COMMAND "${SIMULATOR}" "${path}" "${TEST_DIR}/seed-${seed}-${pass}.wav"
            RESULT_VARIABLE code OUTPUT_QUIET ERROR_VARIABLE error)
        if(NOT code STREQUAL "0")
            message(FATAL_ERROR "Seed ${seed} exit=${code}: ${error}")
        endif()
    endforeach()
    file(SHA256 "${TEST_DIR}/seed-${seed}-1.wav" first_hash)
    file(SHA256 "${TEST_DIR}/seed-${seed}-2.wav" second_hash)
    if(NOT first_hash STREQUAL second_hash)
        message(FATAL_ERROR "Seed ${seed} WAV is not repeatable")
    endif()
endforeach()

execute_process(COMMAND "${SIMULATOR}" RESULT_VARIABLE usage_code OUTPUT_QUIET ERROR_QUIET)
execute_process(COMMAND "${SIMULATOR}" "${TEST_DIR}/missing.json" "${TEST_DIR}/missing.wav"
    RESULT_VARIABLE missing_code OUTPUT_QUIET ERROR_QUIET)
execute_process(COMMAND "${SIMULATOR}" "${fixture}" "${TEST_DIR}/missing-directory/output.wav"
    RESULT_VARIABLE write_code OUTPUT_QUIET ERROR_QUIET)
if(NOT usage_code STREQUAL "5" OR NOT missing_code STREQUAL "5" OR
   NOT write_code STREQUAL "3" OR EXISTS "${TEST_DIR}/missing.wav")
    message(FATAL_ERROR "Usage/input/write exit codes differ from 5/5/3")
endif()
